{
    "name": "youvision/think-openspout",
    "description": "基于 OpenSpout 的 ThinkPHP 8 数据库导出 Excel/CSV 组件，支持流式写入与大数据量分块导出",
    "type": "library",
    "keywords": [
        "thinkphp",
        "openspout",
        "excel",
        "csv",
        "export"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "openspout/openspout": "^4.0",
        "topthink/framework": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkOpenSpout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkOpenSpout\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkOpenSpout\\OpenSpoutService"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}